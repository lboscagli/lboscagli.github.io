---
import { siteConfig } from "../config";
---

<section id="outreach" class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <div class="lg:col-span-4">
        <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
          Outreach
        </h2>
        <div
          class="w-[75px] h-[5px] mt-2 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        />
      </div>

      <div class="lg:col-span-8">
        <div class="space-y-8">
          {siteConfig.outreach.map((activity) => (
            <article class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
              {activity.type === "article" ? (
                <div class="grid grid-cols-1 sm:grid-cols-5">
                  <div class="sm:col-span-2">
                    {activity.link ? (
                      <a
                        href={activity.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Open newspaper article: ${activity.title}`}
                      >
                        <img
                          src={activity.image}
                          alt={activity.imageAlt}
                          class="h-56 w-full object-cover sm:h-full"
                        />
                      </a>
                    ) : (
                      <img
                        src={activity.image}
                        alt={activity.imageAlt}
                        class="h-56 w-full object-cover sm:h-full"
                      />
                    )}
                  </div>
                  <div class="space-y-4 p-5 sm:col-span-3 sm:p-7">
                    <h3 class="text-xl font-bold text-gray-900">
                      {activity.title}
                    </h3>
                    <p class="text-base text-gray-600 leading-relaxed">
                      {activity.description}
                    </p>
                    {activity.link && (
                      <a
                        href={activity.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex font-medium hover:underline"
                        style={`color: ${siteConfig.accentColor}`}
                      >
                        {activity.linkText}
                        <span class="sr-only"> (opens in a new tab)</span>
                      </a>
                    )}
                  </div>
                </div>
              ) : (
                <div class="grid grid-cols-1 sm:grid-cols-5">
                  <img
                    src={activity.image}
                    alt={activity.imageAlt}
                    class="h-56 w-full object-cover sm:col-span-2 sm:h-full"
                  />
                  <div class="space-y-3 p-5 sm:col-span-3 sm:p-7">
                    <p
                      class="text-sm font-medium"
                      style={`color: ${siteConfig.accentColor}`}
                    >
                      {activity.date}
                    </p>
                    <h3 class="text-xl font-bold text-gray-900">
                      {activity.title}
                    </h3>
                    <p class="text-base text-gray-600 leading-relaxed">
                      {activity.description}
                    </p>
                  </div>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
